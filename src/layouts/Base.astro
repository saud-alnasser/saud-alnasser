---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { localeInfo, otherLocale, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';
import { absolute, withBase } from '../lib/paths';
import { credits } from '../lib/technologies';
import Icon from '../components/Icon.astro';
import LanguageMenu from '../components/LanguageMenu.astro';
import SiteMenu from '../components/SiteMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  // The route without its locale prefix, with the trailing slash: "/",
  // "/cv/", "/resume/". The layout builds the canonical address, the
  // language menu, and the alternates from it.
  path: string;
  // The width of the page: `grid` for a page laying cards in columns, 64rem;
  // `document` for the CV, which reads as one column of text, 48rem. The
  // content and the footer take it; the header's row is 64rem on every page,
  // because the whole row fits in nothing narrower.
  column: 'document' | 'grid';
}

const { locale, title, description, path, column } = Astro.props;
const { dir, ogLocale } = localeInfo(locale);
const other = otherLocale(locale);
const t = strings[locale];
const width = column === 'grid' ? 'max-w-5xl' : 'max-w-3xl';

const profile = (await getEntry('profile', 'profile'))!;
const text = localized(locale, 'profile', profile.id);
const siteName = text('name', profile.data.name);

// The site lives under a base path, so every path here goes through
// withBase, and every full address through absolute (src/lib/paths.ts).
const site = Astro.site!;
const home = withBase(`/${locale}/`);
const address = (l: Locale) => absolute(`/${l}${path}`, site);

// The Latin pair on every page, since names, addresses, and technologies are
// written in it in both languages; the Arabic pair only where the page is in
// Arabic, which is also the only place its unicode-range ever matches.
const fonts = [
  'SourceSans3-Regular',
  'SourceSans3-Bold',
  ...(locale === 'ar' ? ['NotoNaskhArabic-Regular', 'NotoNaskhArabic-Bold'] : []),
];

const logoCredits = credits();

// The header's links, the same on every page: the five sections of the home
// page, each by the anchor its heading carries, so from a document they lead
// back to the section; and the two documents, the one being read marked as
// the current page.
const sections = (['about', 'experience', 'projects', 'education', 'skills'] as const).map((id) => ({
  id,
  href: `${home}#${id}`,
  label: t.nav[id],
}));
const documents = [
  { href: withBase(`/${locale}/cv/`), label: t.nav.cv, current: path === '/cv/' },
  { href: withBase(`/${locale}/resume/`), label: t.nav.resume, current: path === '/resume/' },
];
const link =
  'relative inline-flex min-h-6 min-w-6 items-center gap-1.5 py-2 whitespace-nowrap text-muted-foreground hover:text-primary motion-safe:transition-colors';
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <!--
      The bundled faces the page draws with, asked for before the stylesheet
      is read, so the text is laid out once in its own face rather than in the
      fallback and again when the face arrives. That second layout moves the
      whole page, and the Arabic pages measure it as a layout shift of a third
      of the screen.
    -->
    {
      fonts.map((font) => (
        <link rel="preload" href={withBase(`/fonts/${font}.woff2`)} as="font" type="font/woff2" crossorigin />
      ))
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={address(locale)} />
    <link rel="alternate" hreflang={locale} href={address(locale)} />
    <link rel="alternate" hreflang={other} href={address(other)} />
    <link rel="alternate" hreflang="x-default" href={address('en')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={address(locale)} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={localeInfo(other).ogLocale} />
    <!--
      The only script on the site. It applies a stored theme before first
      paint, so the page never flashes the other palette, wires the theme
      control once the document is parsed, closes the language menu and the
      phone menu on Escape and on a click outside them, glides the home page
      to a section when a header link is pressed and marks the section being
      read, rises the headings and cards below the first screen into place as
      they scroll in and counts the home page's numbers up as they first
      show, runs the projects' technology filter, opens a certificate card in
      the page's dialog, and turns a document page's download control into
      the form that fills the contact line and prints, which it does only
      where the page's address carries the marker. All but the theme work
      without it: the menus open and close on their own, a section link
      jumps to its heading and the scroll padding keeps it clear of the
      header, nothing is ever hidden for the reveal to undo and every number
      is already its final figure, the filter's row stays hidden and every
      project shows, a certificate card is the link to its PDF that it
      already is, and the download control is the link to the published PDF
      that it already is, which is what every unmarked click gets too.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (error) {}
        if (stored === 'light' || stored === 'dark') root.setAttribute('data-theme', stored);

        function current() {
          return (
            root.getAttribute('data-theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          );
        }

        // Closes an open menu, the language menu or the phone menu, when the
        // event landed outside it or was Escape, and puts focus back on its
        // summary in the second case.
        function dismiss(event) {
          var menus = document.querySelectorAll('[data-language-menu][open], [data-site-menu][open]');
          Array.prototype.forEach.call(menus, function (menu) {
            if (event.type === 'keydown') {
              if (event.key !== 'Escape') return;
              menu.removeAttribute('open');
              var summary = menu.querySelector('summary');
              if (summary) summary.focus();
            } else if (!menu.contains(event.target)) {
              menu.removeAttribute('open');
            }
          });
        }

        // The home page's sections and the header's links to them. The link
        // for the section being read carries `aria-current="location"`, in
        // the header's row and in the phone menu alike: the last section
        // whose heading has reached the line a jump leaves a heading on, the
        // first before any has, and the last at the foot of the page. It is
        // read from the headings' positions once per frame while the page
        // scrolls, so it is a function of where the page is and nothing else.
        //
        // A plain press on a section link whose section is on this page
        // glides there instead of jumping: 350ms on the entrance curve, to
        // where the jump would have left the heading, the scroll padding
        // below the header. Under reduced motion it goes there in one step.
        // Either way the address then takes the anchor, through pushState so
        // the browser does not jump again, and focus moves to the heading, so
        // the next Tab starts from the section. A modified press, and a press
        // on a document page, whose sections are on another page, are left to
        // the browser. The phone menu closes on the press.
        //
        // Without this the links are the anchors they already are: the jump
        // lands in the same place, and only the glide and the mark are lost.
        function sections() {
          var headings = document.querySelectorAll('[data-section]');
          var links = document.querySelectorAll('[data-section-link]');
          var header = document.querySelector('body > header');
          var glide = null;

          document.addEventListener('click', function (event) {
            var link = event.target.closest ? event.target.closest('[data-section-link]') : null;
            if (!link) return;
            var menu = link.closest('[data-site-menu]');
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            if (menu) menu.removeAttribute('open');
            if (!headings.length || link.pathname !== location.pathname) return;
            var heading = document.getElementById(link.getAttribute('data-section-link'));
            if (!heading) return;
            event.preventDefault();
            go(heading);
          });

          if (!headings.length) return;

          // The line a jump leaves a heading on: the scroll padding, which is
          // the header's height and a step more.
          function line() {
            return parseFloat(getComputedStyle(root).scrollPaddingTop) || header.getBoundingClientRect().bottom;
          }

          // Where the page stands with a heading on the line. Measured through
          // the heading's section rather than the heading itself, which may be
          // mid-reveal and moved by it.
          function stop(heading) {
            var box = (heading.closest('section') || heading).getBoundingClientRect();
            var end = document.documentElement.scrollHeight - window.innerHeight;
            return Math.max(0, Math.min(end, window.scrollY + box.top - line()));
          }

          function arrive(heading) {
            glide = null;
            history.pushState(null, '', '#' + heading.id);
            heading.setAttribute('tabindex', '-1');
            heading.focus({ preventScroll: true });
            mark();
          }

          function go(heading) {
            var from = window.scrollY;
            var to = stop(heading);
            if (!matchMedia('(prefers-reduced-motion: no-preference)').matches || from === to) {
              window.scrollTo(0, to);
              arrive(heading);
              return;
            }
            var start = null;
            var token = {};
            glide = token;
            function step(now) {
              if (glide !== token) return;
              if (start === null) start = now;
              var progress = Math.min((now - start) / 350, 1);
              window.scrollTo(0, from + (to - from) * enter(progress));
              if (progress < 1) requestAnimationFrame(step);
              else arrive(heading);
            }
            requestAnimationFrame(step);
          }

          function mark() {
            var reach = line() + 8;
            var current = headings[0];
            var foot = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
            Array.prototype.forEach.call(headings, function (heading) {
              if ((heading.closest('section') || heading).getBoundingClientRect().top <= reach) current = heading;
            });
            if (foot) current = headings[headings.length - 1];
            Array.prototype.forEach.call(links, function (link) {
              if (link.getAttribute('data-section-link') === current.id) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }

          var queued = false;
          window.addEventListener(
            'scroll',
            function () {
              if (queued) return;
              queued = true;
              requestAnimationFrame(function () {
                queued = false;
                mark();
              });
            },
            { passive: true },
          );
          mark();
        }

        // Turns a click on a certificate card into the page's dialog: the
        // preview, the caption, and the address the card carries. Without
        // this the card is the link to its PDF it already is, which is why a
        // modified click (a new tab, a download) is left alone, and why a
        // browser whose dialog cannot open modally is left alone too: the
        // link is cancelled only where the dialog will open. Escape and the
        // focus trap are the dialog's own; the close returns focus to the
        // card that opened it.
        function certificates() {
          var dialog = document.querySelector('[data-certificate-dialog]');
          if (!dialog || typeof dialog.showModal !== 'function') return;
          var image = dialog.querySelector('[data-certificate-image]');
          var caption = dialog.querySelector('[data-certificate-caption]');
          var link = dialog.querySelector('[data-certificate-link]');
          var opener = null;

          document.addEventListener('click', function (event) {
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            var card = event.target.closest ? event.target.closest('[data-document]') : null;
            if (!card) return;
            event.preventDefault();
            // The size first, so the dialog opens at the box the image will
            // fill rather than growing when it arrives.
            image.setAttribute('width', card.getAttribute('data-preview-width'));
            image.setAttribute('height', card.getAttribute('data-preview-height'));
            image.setAttribute('src', card.getAttribute('data-preview'));
            image.setAttribute('alt', card.getAttribute('data-caption'));
            caption.textContent = card.getAttribute('data-caption');
            link.setAttribute('href', card.getAttribute('data-document'));
            opener = card;
            dialog.showModal();
          });

          // The close control, and the backdrop, which is a click whose target
          // is the dialog itself rather than anything inside it.
          dialog.addEventListener('click', function (event) {
            var close = event.target.closest ? event.target.closest('[data-certificate-close]') : null;
            if (close || event.target === dialog) dialog.close();
          });

          dialog.addEventListener('close', function () {
            if (opener) opener.focus();
            opener = null;
          });
        }

        // Turns the download control on a document page into the form that
        // fills the document's contact line, then prints it, and only where
        // the page was opened at the marked address. The values go into the
        // two hidden slots the contact line already has, the page prints under
        // the name the published document already has, and the slots and the
        // title are both put back; docs/development.md says why the document is
        // made here rather than published, and at which address. Nothing is
        // stored and nothing is sent.
        //
        // Everywhere else the control is the link to the published PDF it
        // already is: at an unmarked address, with no script at all, and in a
        // browser whose dialog cannot open modally. The link is cancelled only
        // where the dialog is about to open.
        function documents() {
          var dialog = document.querySelector('[data-document-dialog]');
          var contact = document.querySelector('[data-cv-contact]');
          if (!dialog || !contact || typeof dialog.showModal !== 'function') return;
          var form = dialog.querySelector('[data-document-form]');
          var opener = null;
          // Set between the generate and the close it causes, so the close
          // handler prints instead of clearing. Printing is deferred to the
          // close event rather than called beside it, because a modal dialog
          // would otherwise be part of what prints, and because the order of
          // a queued close event against a synchronous print is not something
          // to depend on.
          var generating = false;

          function slot(which) {
            return contact.querySelector('[data-contact-slot="' + which + '"]');
          }

          // Chrome names a printed PDF after the page's title and appends
          // `.pdf`, so the title is what decides the name a generated document
          // lands under, and for the length of the print it is the published
          // document's: `/saud-alnasser/resume.en.pdf` gives `resume.en`, and
          // the extension comes back on the way out. Read off the control's own
          // address rather than written down here, so the file a reader
          // generates and the one the site publishes cannot disagree.
          function named(control) {
            return control.getAttribute('href').split('/').pop().replace(/\.[^.]+$/, '');
          }

          // The page's own title, and putting it back. It goes everywhere the
          // clear below goes and once more besides, the moment print() returns,
          // because a title left behind renames the tab, the history entry, and
          // anything bookmarked from it, and `afterprint` is no more reliable
          // here than it is for the contact line.
          //
          // It writes only where the title has actually moved, because a reader
          // who opens the form and changes their mind has to see it stand
          // completely still, and assigning a title its own value still replaces
          // the text anything watching the document is watching.
          var title = document.title;
          function restore() {
            if (document.title !== title) document.title = title;
          }

          // Back to the state a published document is in: both slots empty and
          // hidden. Idempotent, because both the close path and afterprint
          // call it.
          function clear() {
            ['email', 'phone'].forEach(function (which) {
              var item = slot(which);
              if (!item) return;
              item.querySelector('span').textContent = '';
              item.hidden = true;
            });
            if (form) form.reset();
          }

          // Whether this page was opened at the address the form belongs to.
          // The token is written here and in scripts/form-marker.mjs, which is
          // what the render step and the tests navigate with; this script
          // cannot import that module, so the two are held together by every
          // test that opens the form failing where they disagree. Compared
          // lowercased, so a fragment typed as #ME still works.
          //
          // It latches, and only ever turns on. The skip link is the first
          // focusable element in the body and points at #content, so the one
          // reader this form is for replaces the fragment before reaching the
          // control. A gate that re-read the address at the click would be off
          // by then, and silently: the icon would simply download.
          function mine() {
            return location.hash.toLowerCase() === '#me';
          }
          var marked = mine();
          window.addEventListener('hashchange', function () {
            if (mine()) marked = true;
          });

          document.addEventListener('click', function (event) {
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            var control = event.target.closest ? event.target.closest('[data-document-download]') : null;
            if (!control) return;
            // Unmarked, the control does what its href says and downloads the
            // published PDF, which is what every reader of the site gets. The
            // guard sits after the lookup rather than at the top of the
            // handler, and nowhere near the early return above, because the
            // handlers have to be bound for the latch to be able to fire later.
            if (!marked) return;
            event.preventDefault();
            // The third of three clears, and the one that needs no event to
            // fire: a dismissed dialog clears on close and a printed document
            // clears on afterprint, but a browser that fires neither would
            // otherwise hand the next reader of this tab the last one's
            // details, on the document and in the fields, and leave the tab
            // still calling itself by the last document's file name.
            clear();
            restore();
            opener = control;
            dialog.showModal();
          });

          if (form) {
            form.addEventListener('submit', function (event) {
              // Nothing is submitted anywhere: the form has no action, its
              // method is `dialog`, and this cancels even that.
              event.preventDefault();
              ['email', 'phone'].forEach(function (which) {
                var item = slot(which);
                var value = form.querySelector('[data-document-field="' + which + '"]').value.trim();
                if (!item) return;
                item.querySelector('span').textContent = value;
                item.hidden = value === '';
              });
              generating = true;
              dialog.close();
            });
          }

          dialog.addEventListener('click', function (event) {
            var close = event.target.closest ? event.target.closest('[data-document-close]') : null;
            if (close || event.target === dialog) dialog.close();
          });

          dialog.addEventListener('close', function () {
            var control = opener;
            opener = null;
            if (control) control.focus();
            if (generating) {
              generating = false;
              document.title = named(control);
              // `finally`, because a print() that throws would otherwise skip
              // the restore and leave the tab, its history entry, and anything
              // bookmarked from it calling themselves resume.en for the life
              // of the page. `afterprint` does not fire in that case either,
              // so this is the only restore standing.
              //
              // The restore only, and not the clear beside it, which is the
              // one asymmetry here that is deliberate. The contact line has to
              // survive this call: the document is still being printed when
              // print() returns, so emptying the slots here would take the
              // reader's details off the very page being rendered. That is why
              // clearing is `afterprint`'s and the dialog's, and why a
              // throwing print() leaves the line filled in the reader's own
              // tab until the next click. Their data, their machine, nothing
              // published. Tried on 2026-09-11: pairing them here fails 40
              // cases that assert the line is filled after the print.
              try {
                window.print();
              } finally {
                restore();
              }
              return;
            }
            clear();
            restore();
          });

          // The other half of both. `afterprint` is not uniformly reliable,
          // which is why the close path clears and restores as well.
          window.addEventListener('afterprint', function () {
            clear();
            restore();
          });
        }

        // Rises each section heading and grid card below the first screen
        // into place once, the first time a tenth of it scrolls into view.
        // The hidden state is the stylesheet's, and it applies only while the
        // root carries `data-reveal`, which is set here, last, after every
        // marked element already on screen has been marked revealed and every
        // other one handed to the observer that ends it. So a visitor who
        // asked for reduced motion, a browser with no observer, and a page
        // with no script at all never have anything hidden, and what is on
        // screen at load is never hidden either: that belongs to the page's
        // entrance.
        //
        // A revealed element holding a stat tile's number also counts it up,
        // once, from nothing to the figure the page was built with, over
        // 350ms on the stylesheet's entrance curve, so it lands the way every
        // other arrival on the page does. The figure is already in the page,
        // so wherever this does not run the tile simply shows it.
        function reveal() {
          if (typeof IntersectionObserver !== 'function') return;
          if (!matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
          var marked = document.querySelectorAll('[data-reveal]');
          if (!marked.length) return;
          function shown(element) {
            element.setAttribute('data-revealed', '');
            Array.prototype.forEach.call(element.querySelectorAll('[data-count]'), count);
          }
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                shown(entry.target);
                observer.unobserve(entry.target);
              });
            },
            { threshold: 0.1 },
          );
          var fold = window.innerHeight;
          Array.prototype.forEach.call(marked, function (element) {
            if (element.getBoundingClientRect().top < fold) shown(element);
            else observer.observe(element);
          });
          root.setAttribute('data-reveal', '');
        }

        // The entrance curve, --ease-enter in the stylesheet,
        // cubic-bezier(0.05, 0.7, 0.1, 1): how far along the count is at a
        // given fraction of the time, found by halving for the curve's
        // parameter at that time.
        function enter(time) {
          function at(t, a, b) {
            return 3 * (1 - t) * (1 - t) * t * a + 3 * (1 - t) * t * t * b + t * t * t;
          }
          var low = 0;
          var high = 1;
          for (var i = 0; i < 24; i += 1) {
            var middle = (low + high) / 2;
            if (at(middle, 0.05, 0.1) < time) low = middle;
            else high = middle;
          }
          return at((low + high) / 2, 0.7, 1);
        }

        function count(counter) {
          var target = Number(counter.getAttribute('data-count'));
          if (!(target > 0)) return;
          var start = null;
          function step(now) {
            if (start === null) start = now;
            var progress = Math.min((now - start) / 350, 1);
            counter.textContent = String(Math.round(target * enter(progress)));
            if (progress < 1) requestAnimationFrame(step);
          }
          counter.textContent = '0';
          requestAnimationFrame(step);
        }

        // Shows the projects' technology chips and runs them: a press marks
        // that chip pressed and every other not, hides the projects that do
        // not name its technology, the featured card in its place above the
        // grid among them, and writes the chip's own line,
        // counted and declined when the page was built, into the status
        // region, which a screen reader announces. The empty technology is
        // "All". Without this the row stays hidden and every project shows.
        function filter() {
          var group = document.querySelector('[data-filter]');
          var status = document.querySelector('[data-filter-status]');
          if (!group || !status) return;
          var chips = group.querySelectorAll('[data-filter-chip]');
          var items = document.querySelectorAll(
            '[data-grid="projects"] > [data-technologies], [data-featured-project][data-technologies]',
          );
          group.hidden = false;
          group.addEventListener('click', function (event) {
            var chip = event.target.closest ? event.target.closest('[data-filter-chip]') : null;
            if (!chip) return;
            var chosen = chip.getAttribute('data-filter-chip');
            Array.prototype.forEach.call(chips, function (other) {
              other.setAttribute('aria-pressed', other === chip ? 'true' : 'false');
            });
            Array.prototype.forEach.call(items, function (item) {
              item.hidden = chosen !== '' && item.getAttribute('data-technologies').split('|').indexOf(chosen) === -1;
            });
            status.textContent = chip.getAttribute('data-status');
          });
        }

        document.addEventListener('DOMContentLoaded', function () {
          document.addEventListener('click', dismiss);
          document.addEventListener('keydown', dismiss);
          sections();
          reveal();
          filter();
          certificates();
          documents();

          var control = document.querySelector('[data-theme-toggle]');
          if (!control) return;
          control.addEventListener('click', function () {
            var next = current() === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch (error) {}
          });
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased motion-safe:transition-colors motion-safe:duration-300">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-30 focus:rounded-md focus:bg-background focus:px-3 focus:py-2"
    >
      {t.skipToContent}
    </a>

    <!--
      The header stays on screen as the page scrolls: a bar of its own height
      (`--header-height`, which the stylesheet also scrolls every jump clear
      of), on the page's background, with a border under it. One row, in the
      order a keyboard reaches it: the name, leading to the top of the home
      page; the five sections; the two documents, set apart as a group of
      their own with the file icon; and the language and theme controls.

      Below `lg` the row cannot hold all of it in either language, so the
      sections and the documents fold into the phone menu, a native
      disclosure at the end of the row that needs no script to open, close,
      or lead anywhere.

      The current link carries `aria-current` and a bar in the accent, so it
      does not rest on a text colour: a document's own link on that document,
      and on the home page the section being read, which the inline script
      marks. Every link and button here is at least 24 pixels each way.
    -->
    <header class="sticky top-0 z-20 border-b border-border bg-background">
      <div class="mx-auto flex h-(--header-height) w-full max-w-5xl items-center gap-x-4 px-6">
        <a href={home} class="inline-flex min-h-6 items-center py-1 text-base font-semibold tracking-tight whitespace-nowrap hover:text-primary">
          {siteName}
        </a>
        <nav aria-label={t.nav.label} class="ms-auto hidden items-center text-sm lg:flex">
          <ul class="flex items-center gap-x-5">
            {
              sections.map((section) => (
                <li>
                  <a href={section.href} data-nav-link data-section-link={section.id} class={link}>
                    {section.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul aria-label={t.nav.documents} class="ms-5 flex items-center gap-x-4 border-s border-border ps-5">
            {
              documents.map((document) => (
                <li>
                  <a href={document.href} data-nav-link aria-current={document.current ? 'page' : undefined} class={link}>
                    <Icon name="file-text" class="size-4" />
                    {document.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <ul class="ms-auto flex items-center gap-x-1 lg:ms-0">
          <li>
            <LanguageMenu locale={locale} path={path} />
          </li>
          <li>
            <ThemeToggle locale={locale} />
          </li>
          <li class="lg:hidden">
            <SiteMenu locale={locale} sections={sections} documents={documents} />
          </li>
        </ul>
      </div>
    </header>

    <main id="content" class:list={['mx-auto w-full px-6 py-16 sm:py-20', width]}>
      <slot />
    </main>

    <!--
      The foot of every page: the site's name, and the attribution the
      technology marks' licences ask for, folded behind one native control
      so it is there for whoever looks and out of the way of everyone else.
      One line per mark: its name, its licence, and a link to where it is
      from, under the note the licences ask for that each mark was changed.
      On paper the documents print without it, as without the header.
    -->
    <footer class:list={['mx-auto w-full px-6 pb-12 text-sm text-muted-foreground', width]}>
      <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-3 border-t border-border pt-6">
        <p>{siteName}</p>
        {
          logoCredits.length > 0 && (
            <details data-logo-credits>
              <summary class="flex min-h-6 cursor-pointer list-none items-center gap-1.5 select-none hover:text-primary motion-safe:transition-colors">
                {t.footer.credits}
                <Icon name="chevron-down" class="fold-chevron size-4 motion-safe:transition-transform" />
              </summary>
              <p class="mt-3">{t.footer.adapted}</p>
              <ul class="mt-2 space-y-1">
                {logoCredits.map((credit) => (
                  <li>
                    <bdi>{credit.name}</bdi>: <bdi>{credit.licence}</bdi>
                    {t.listSeparator}
                    <a href={credit.source} class="text-primary underline underline-offset-4 hover:decoration-2">
                      {t.footer.source}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </footer>

    <!--
      A page's dialog, if it has one, sits here rather than inside <main>:
      the entrance on main's children is a transform, and a transform on an
      ancestor takes a <dialog> out of the top layer in some browsers.
    -->
    <slot name="dialog" />

  </body>
</html>
