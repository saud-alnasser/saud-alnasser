---
// The one project a page puts forward: the project the content marks
// `featured`, found by `featuredProject` in src/lib/shown.ts. It is the same
// project a grid card would show, said at more length: a raised card across
// the whole column, under a "Featured" label with a star, with the name
// larger, the summary at reading size, every technology as a badge with none
// folded away, and its links. The page that renders it leaves the project out
// of the grid below, so it appears once.

import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import Icon from './Icon.astro';
import ProjectLinks from './ProjectLinks.astro';
import { formatPeriod, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
  class?: string;
  // Anything else goes on the card: the work page's filter reads the
  // technologies from it.
  [attribute: string]: unknown;
}

const { locale, entry, class: className, ...rest } = Astro.props as Props;
const { data } = entry;
const t = strings[locale];
const text = localized(locale, 'projects', entry.id);
---

<Card as="article" variant="raised" data-featured-project class:list={['sm:p-8', className]} {...rest}>
  <p class="flex items-center gap-1.5 text-sm font-medium text-primary">
    <Icon name="star" class="size-4" />
    {t.project.featured}
  </p>
  <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">{data.name}</h3>
    <p class="text-sm text-muted-foreground tabular-nums" data-period>{formatPeriod(locale, data.period)}</p>
  </div>
  <p class="mt-1 text-sm text-muted-foreground">{text('role', data.role)}</p>
  <p class="mt-4 max-w-prose leading-7 sm:text-lg sm:leading-8">{text('summary', data.summary)}</p>
  <ul aria-label={t.project.technologies} class="mt-5 flex flex-wrap gap-1.5">
    {
      data.technologies.map((technology) => (
        <li>
          <Badge name={technology} />
        </li>
      ))
    }
  </ul>
  <ProjectLinks locale={locale} entry={entry} />
</Card>
