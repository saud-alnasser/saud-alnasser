---
// A project card. The whole card is not a link, because a public project has
// up to two destinations and a described one has none; the links sit inside
// it, each with the icon that says what it opens. The technologies and the
// links are pushed to the foot, so cards in a row line up on their last line
// however long a summary runs.
//
// The technologies are badges, the first five in view and the rest folded
// behind a control that says how many, so a long stack does not push the
// card's links out of line with its neighbours'.

import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import Fold from './Fold.astro';
import ProjectLinks from './ProjectLinks.astro';
import { formatPeriod, strings, type Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'projects'>;
}

const { locale, entry } = Astro.props;
const { data } = entry;
const t = strings[locale];
const text = localized(locale, 'projects', entry.id);

const inView = data.technologies.slice(0, 5);
const folded = data.technologies.slice(5);
---

<Card as="article" data-entry="project" class="h-full">
  <div class="flex h-full flex-col">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-lg font-semibold tracking-tight">{data.name}</h3>
      <p class="text-sm text-muted-foreground tabular-nums" data-period>{formatPeriod(locale, data.period)}</p>
    </div>
    <p class="mt-1 text-sm text-muted-foreground">{text('role', data.role)}</p>
    <p class="mt-3 leading-7">{text('summary', data.summary)}</p>

    <div class="mt-auto">
      <ul aria-label={t.project.technologies} class="mt-4 flex flex-wrap gap-1.5">
        {
          inView.map((technology) => (
            <li>
              <Badge name={technology} />
            </li>
          ))
        }
      </ul>
      {
        folded.length > 0 && (
          <Fold locale={locale} count={folded.length} noun="technologies" class="mt-3">
            <ul class="flex flex-wrap gap-1.5">
              {folded.map((technology) => (
                <li>
                  <Badge name={technology} />
                </li>
              ))}
            </ul>
          </Fold>
        )
      }
      <ProjectLinks locale={locale} entry={entry} />
    </div>
  </div>
</Card>
