---
// The language control: a native <details> whose summary shows the languages
// icon and the current language's code, and whose list holds every language
// the site is published in, each in its own name and script, as an ordinary
// link to the same route in that language. The current one carries
// aria-current. Opening and closing is the browser's, so with scripting off
// the other language is still one click away; the inline script in the base
// layout only closes it on Escape and on a click outside.
//
// The list hangs from the control's own end edge. The control sits at the
// end of the header's first row at every width, a phone included, so the
// list opens under it and grows toward the start, inside the column, in both
// directions.

import Icon from './Icon.astro';
import { locales, strings, type Locale } from '../lib/i18n';
import { withBase } from '../lib/paths';

interface Props {
  locale: Locale;
  // The route without its locale prefix, with the trailing slash.
  path: string;
}

const { locale, path } = Astro.props;
const t = strings[locale];
---

<details data-language-menu class="relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2 py-1.5 text-muted-foreground select-none hover:text-primary motion-safe:transition-colors"
  >
    <Icon name="languages" class="size-4" />
    <span class="sr-only">{t.nav.language}: </span>
    <span class="text-xs font-medium uppercase">{locale}</span>
    <Icon name="chevron-down" class="fold-chevron size-3.5 motion-safe:transition-transform" />
  </summary>
  <ul
    class="absolute end-0 top-full z-10 mt-2 min-w-40 rounded-lg border border-border bg-card p-1 text-sm"
  >
    {
      locales.map((l) => {
        const current = l.code === locale;
        return (
          <li>
            <a
              href={withBase(`/${l.code}${path}`)}
              hreflang={l.code}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between gap-4 rounded-md px-3 py-2 text-start hover:bg-muted motion-safe:transition-colors',
                current ? 'text-foreground' : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              <span lang={l.code} dir={l.dir}>{l.name}</span>
              {current && <Icon name="check" class="size-4 text-primary" />}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>
