---
import { getCollection, getEntry } from 'astro:content';
import { formatDate, formatPeriod, strings, type Locale } from '../lib/i18n';
import { levelLine } from '../lib/languages';
import { localized } from '../lib/localized';
import {
  byDateAscending,
  byOrderThenName,
  byOrderThenStartDescending,
  byStartAscending,
  byStartDescending,
} from '../lib/order';
import { codedProfile, profileIcon } from '../lib/networks';
import { isCertification, isCourse, isShown, onResume } from '../lib/shown';
import QrCode from './QrCode.astro';

// The document both of the site's document pages are: the CV, which holds
// everything the site shows, and the short resume, which holds what an
// application needs. One component rather than two pages of markup, so the
// header, the summary, the experience, the education, and the skills are
// written once and the two cannot drift in layout.
//
// The layout is the white and blue minimalist corporate template Saud chose,
// redesigned as one pair: the name centred in capitals over a rule in the
// accent, the contact details on one centred line, every section heading set
// in the accent over a hairline rule, and each entry's title with its dates
// on one line. It is followed only as far as a resume parser allows, which is
// what it is for: one column in reading order, real text everywhere, standard
// section headings, the contact details in the flow of the document, and no
// table, image, text box, or positioned header or footer. The document order
// below is the order scripts/check-dist.mjs extracts from both PDFs. The
// print rules, and the compact rules the resume prints at, live in
// src/styles/global.css.
//
// What each variant holds, in the order it prints it:
//
//   cv                                    resume
//   ------------------------------------  ------------------------------------
//   name, label, contact line             the same
//   summary, from `summary`               its own, from `resumeSummary`
//   experience, every entry with bullets  the same
//   education, with the course list       education, without the course list
//   skills, the keywords in columns       skills, one line per group
//   languages, one line each              the same
//   certifications, kind: certification   projects, the ones marked resume,
//   courses, kind: course                   without technologies or links
//   projects, every shown project         certifications, the ones marked
//                                         courses, the ones marked
//
// A section prints only where it holds something, so the resume shows neither
// credential heading until an entry is marked, and the CV drops one if its
// kind is left empty.

interface Props {
  locale: Locale;
  // Which document this is. The resume adds `cv-compact` to the article,
  // which is what the tighter print size, the 10mm page box, and the tighter
  // gaps between entries are keyed on.
  variant: 'cv' | 'resume';
}

const { locale, variant } = Astro.props;
const t = strings[locale];
const resume = variant === 'resume';

const profile = (await getEntry('profile', 'profile'))!;
const profileText = localized(locale, 'profile', profile.id);
const name = profileText('name', profile.data.name);
const label = profileText('label', profile.data.label);
// One summary per document, decided here rather than by either page. Each
// names only what its own document prints as an entry, which is what one
// field could not do for two documents carrying different ones
// (src/content/profile.yaml).
const summary = resume
  ? profileText('resumeSummary', profile.data.resumeSummary)
  : profileText('summary', profile.data.summary);
const nationality = profileText('nationality', profile.data.nationality);
const location = profileText('location', profile.data.location);

// The same orders as the pages and the resume endpoint (src/lib/order.ts), so
// every output agrees.
const experience = (await getCollection('experience')).sort((a, b) => byStartDescending(a.data, b.data));
const education = (await getCollection('education')).sort((a, b) => byStartAscending(a.data, b.data));
const skills = (await getCollection('skills')).sort((a, b) => byOrderThenName(a.data, b.data));
const languages = (await getCollection('languages')).sort((a, b) => byOrderThenName(a.data, b.data));
const certificates = (await getCollection('certificates')).sort((a, b) => byDateAscending(a.data, b.data));
const shownProjects = (await getCollection('projects', ({ data }) => isShown(data))).sort((a, b) =>
  byOrderThenStartDescending(a.data, b.data),
);

// Which entries this variant carries. What the resume shows is a fact on each
// entry (src/lib/shown.ts), never a second list beside the content, so the
// resume can never name a project the content source dropped.
const projects = resume ? shownProjects.filter((entry) => onResume(entry.data)) : shownProjects;

// The sections after the skills and the languages, in the order this variant
// prints them, which is the order scripts/check-dist.mjs and
// tests/resume.spec.ts read. The CV is the record, so its credentials come
// before its projects and its course completions have a section of their
// own; the resume leads with the work and carries a credential only where an
// entry is marked for it.
type ProjectSection = { id: 'projects'; entries: typeof shownProjects };
type CertificateSection = { id: 'certifications' | 'courses'; heading: string; entries: typeof certificates };

// A marked certificate keeps its own kind's heading on the resume, as it has
// on the CV: a course completion listed under "Certifications" would claim
// more than the entry says. Nothing is marked today, and both rows render
// only when they hold something, so the resume shows neither until one is.
const tail: (ProjectSection | CertificateSection)[] = resume
  ? [
      { id: 'projects', entries: projects },
      {
        id: 'certifications',
        heading: t.cv.certifications,
        entries: certificates.filter((entry) => isCertification(entry.data) && onResume(entry.data)),
      },
      {
        id: 'courses',
        heading: t.cv.courses,
        entries: certificates.filter((entry) => isCourse(entry.data) && onResume(entry.data)),
      },
    ]
  : [
      {
        id: 'certifications',
        heading: t.cv.certifications,
        entries: certificates.filter((entry) => isCertification(entry.data)),
      },
      { id: 'courses', heading: t.cv.courses, entries: certificates.filter((entry) => isCourse(entry.data)) },
      { id: 'projects', entries: projects },
    ];

// The template's key-skills block on the CV is the keywords themselves, laid
// in columns, which is also what a parser reads for. They keep their groups'
// order, and each appears once: two groups can name the same keyword, as SQL
// is both a language and a database skill. The resume has no room for the
// columns and prints one line per group instead.
const keywords = [...new Set(skills.flatMap((entry) => entry.data.keywords))];

// The LinkedIn address is the header's QR code, and it is the one profile
// either document carries. The code was GitHub's from 2026-09-11, with every
// other profile written out on the contact line so that no fact was dropped
// in silence; on 2026-09-22 Saud swapped the code to LinkedIn and chose to
// take the GitHub address off the documents rather than write it out, so
// the contact line now carries no profile at all. Every profile still
// reaches the home page, the README, and both resume.json documents, which
// read the same list. `codedProfile` decides which entry is the code, and it
// is the same function the dist check and the browser case ask.
const coded = codedProfile(profile.data.profiles);

const link = 'text-primary underline underline-offset-4 hover:decoration-2';
// A section heading: the accent over a hairline rule that runs the width of
// the column. It replaced a full-width tinted band, which was the template's
// one background colour and the only thing on either document that needed
// `print-color-adjust: exact`. A rule is a border rather than a background,
// so it prints whatever the reader's dialog is set to and the document stops
// depending on that setting at all (tests/theme.spec.ts says so).
//
// Tracking stays at 0.025em here and on the name, because `pdftotext -layout`
// turns wider tracking into spaces between the letters. `.cv-heading` carries
// no style of its own; it is what the compact print rules in global.css key
// the gaps above and below a heading on.
const heading =
  'cv-heading mt-8 border-b border-primary/40 pb-1 font-semibold uppercase tracking-[0.025em] text-primary';
// An entry's first line: the title at the start, the dates at the far edge.
// Logical properties throughout, so Arabic mirrors it with no second rule.
const row = 'flex flex-wrap items-baseline justify-between gap-x-4';
// A period is the quietest thing on an entry's line, so it reads as the
// title's date rather than competing with it for the same weight.
const period = 'tabular-nums text-muted-foreground';
const muted = 'text-sm text-muted-foreground';
---

<article class:list={['cv', resume && 'cv-compact']}>
  {/* The name block, which is the one place in the document with a hierarchy:
      the name, then the label under it, then the contact line smaller again,
      over a rule heavier than a section heading's and in the same accent. It
      is the document's strongest line and it now reads like it.

      The QR code sits at the trailing edge and the spacer before the text
      balances it, so the name stays centred on the paper rather than centred
      in what is left over. The spacer is empty and hidden from assistive
      technology; it is a box, not a fact. Logical properties throughout, so
      Arabic mirrors the whole row with no second rule.

      The row is flex rather than positioned: a fixed or absolute element
      carrying content inside the document is what a resume parser most often
      scrambles, so tests/resume.spec.ts refuses one outright. */}
  <header class="cv-entry flex items-center gap-x-6 border-b-2 border-primary pb-5">
    <div aria-hidden="true" class="w-[80px] shrink-0"></div>
    <div class="min-w-0 flex-1 text-center">
      <h1 class="text-3xl font-semibold uppercase tracking-[0.025em]">{name}</h1>
      <p class="mt-1 text-muted-foreground">{label}</p>
      {/* One line, in the flow of the document. The bars separate the items for
          a reader and are hidden from a screen reader, which has the list.
          Every item carries its bar at the trailing edge and the last one's is
          hidden in global.css, because the first two items are empty until a
          reader fills them and a leading bar would be stranded the rest of the
          time. An optional item added at the end would break that; the front is
          where they belong.

          The two slots are what the download form writes into. The published
          document renders them hidden and empty, which is the whole of how this
          site publishes no contact detail; docs/development.md says why. */}
      <ul
        aria-label={t.home.contact}
        data-cv-contact
        class="cv-contact mt-3 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm"
      >
        <li data-contact-slot="email" hidden class="flex items-center gap-x-2">
          <span></span>
          <span aria-hidden="true" class="text-muted-foreground">|</span>
        </li>
        <li data-contact-slot="phone" hidden class="flex items-center gap-x-2">
          <span></span>
          <span aria-hidden="true" class="text-muted-foreground">|</span>
        </li>
        <li class="flex items-center gap-x-2">
          <span>{nationality}</span>
          <span aria-hidden="true" class="text-muted-foreground">|</span>
        </li>
        <li class="flex items-center gap-x-2">
          <span>{location}</span>
          <span aria-hidden="true" class="text-muted-foreground">|</span>
        </li>
      </ul>
    </div>
    {
      coded && (
        <QrCode url={coded.url} label={`${coded.network}: ${coded.url}`} mark={profileIcon(coded.network)} />
      )
    }
  </header>

  <section aria-labelledby="cv-summary" data-cv-section="summary">
    <h2 id="cv-summary" class={heading}>{t.cv.summary}</h2>
    <p class="mt-3 leading-6">{summary}</p>
  </section>

  <section aria-labelledby="cv-experience" data-cv-section="experience">
    <h2 id="cv-experience" class={heading}>{t.cv.experience}</h2>
    <ol class="mt-3 space-y-5">
      {
        experience.map((entry) => {
          const { data } = entry;
          const text = localized(locale, 'experience', entry.id);
          return (
            <li class="cv-entry">
              <div class={row}>
                <h3 class="font-semibold">
                  {text('position', data.position)}
                  {data.kind === 'training' && ` (${t.experience.training})`}
                </h3>
                <p class={period} data-period>{formatPeriod(locale, data.period)}</p>
              </div>
              <p class={muted}>
                <span class="text-foreground">{text('organisation', data.organisation)}</span>
                {t.listSeparator}
                {text('location', data.location)}
              </p>
              <p class="mt-2 leading-6">{text('summary', data.summary)}</p>
              {data.highlights.length > 0 && (
                <ul aria-label={t.experience.highlights} class="mt-2 list-disc space-y-1 ps-5 leading-6 marker:text-primary">
                  {data.highlights.map((highlight, index) => (
                    <li>{text(`highlights[${index}]`, highlight)}</li>
                  ))}
                </ul>
              )}
            </li>
          );
        })
      }
    </ol>
  </section>

  <section aria-labelledby="cv-education" data-cv-section="education">
    <h2 id="cv-education" class={heading}>{t.nav.education}</h2>
    <ol class="mt-3 space-y-5">
      {
        education.map((entry) => {
          const { data } = entry;
          const text = localized(locale, 'education', entry.id);
          return (
            <li class="cv-entry">
              <div class={row}>
                <h3 class="font-semibold">
                  {text('studyType', data.studyType)}
                  {t.listSeparator}
                  {text('area', data.area)}
                </h3>
                <p class={period} data-period>{formatPeriod(locale, data.period)}</p>
              </div>
              <p class="text-sm">{text('institution', data.institution)}</p>
              {/* Only the statuses the period does not already say; see
                  src/components/Education.astro. */}
              {data.status !== 'completed' && (
                <p class={muted} data-status={data.status}>
                  {t.education.status[data.status]}
                </p>
              )}
              {/* The course list is the record's, not the application's: it is
                  the longest block on the page and the first thing the resume
                  does without. */}
              {!resume && data.courses && data.courses.length > 0 && (
                <p class={`mt-2 leading-6 ${muted}`}>
                  <span class="text-foreground">{t.education.courses}: </span>
                  {data.courses.map((course, index) => text(`courses[${index}]`, course)).join(t.listSeparator)}
                </p>
              )}
            </li>
          );
        })
      }
    </ol>
  </section>

  {
    skills.length > 0 && (
      <section aria-labelledby="cv-skills" data-cv-section="skills">
        <h2 id="cv-skills" class={heading}>
          {t.cv.skills}
        </h2>
        {resume ? (
          // One line per group: the group's name and its keywords, which
          // reads in a third of the height the columns take and still hands
          // a parser every keyword whole.
          <ul class="mt-3 space-y-1 text-sm leading-6">
            {skills.map((entry) => {
              const text = localized(locale, 'skills', entry.id);
              return (
                <li class="cv-entry">
                  <span class="font-medium">{text('name', entry.data.name)}</span>
                  {': '}
                  <span class="text-muted-foreground">{entry.data.keywords.join(t.listSeparator)}</span>
                </li>
              );
            })}
          </ul>
        ) : (
          // Columns, not a grid of cells: each keyword stays whole, so
          // extraction keeps it whatever order the columns come out in.
          <ul class="cv-skills mt-3 columns-2 list-inside list-disc gap-x-8 text-sm leading-6 marker:text-primary sm:columns-3">
            {keywords.map((keyword) => (
              <li class="break-inside-avoid">{keyword}</li>
            ))}
          </ul>
        )}
      </section>
    )
  }

  {/* One line per language, "name: level", in the resume's skills-line
      markup on both variants: the section a Saudi screener and the national
      employment platform look for, placed directly after the key skills on
      the CV and the resume alike. It sits outside `tail` because its place
      does not differ by variant. The English line ends with the test score
      and its year, built by levelLine so the JSON document carries the
      same string. */}
  {
    languages.length > 0 && (
      <section aria-labelledby="cv-languages" data-cv-section="languages">
        <h2 id="cv-languages" class={heading}>
          {t.cv.languages}
        </h2>
        <ul class="mt-3 space-y-1 text-sm leading-6">
          {languages.map((entry) => {
            const text = localized(locale, 'languages', entry.id);
            return (
              <li class="cv-entry">
                <span class="font-medium">{text('name', entry.data.name)}</span>
                {': '}
                <span class="text-muted-foreground">
                  {levelLine(text('level', entry.data.level), entry.data.test, t.listSeparator)}
                </span>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    tail.map(
      (section) =>
        section.entries.length > 0 &&
        (section.id === 'projects' ? (
          <section aria-labelledby="cv-projects" data-cv-section="projects">
            <h2 id="cv-projects" class={heading}>
              {t.sections.projects}
            </h2>
            <ol class="mt-3 space-y-5">
              {section.entries.map((entry) => {
                const { data } = entry;
                const text = localized(locale, 'projects', entry.id);
                // As on the work page: only a public project shows its links,
                // and here they are written out so they survive paper.
                const links = data.visibility === 'public' ? (data.links ?? {}) : {};
                const urls = [links.repository, links.live].filter((url): url is string => Boolean(url));
                return (
                  <li class="cv-entry">
                    <div class={row}>
                      <h3 class="font-semibold">{data.name}</h3>
                      <p class={period} data-period>{formatPeriod(locale, data.period)}</p>
                    </div>
                    <p class={muted}>{text('role', data.role)}</p>
                    <p class="mt-2 leading-6">{text('summary', data.summary)}</p>
                    {/* The technologies and the repository are the record's,
                        not the application's: two lines an entry, over the
                        entries the content marks for the resume, which is a
                        third of the page budget. Every technology is already
                        in the key skills above, and the repository is on the
                        work page and in resume.json, which the LinkedIn
                        profile the header's code opens links to. Both are on
                        the CV, whole. */}
                    {!resume && (
                      <>
                        <p class={`leading-6 ${muted}`}>
                          <span class="text-foreground">{t.project.technologies}: </span>
                          {data.technologies.join(t.listSeparator)}
                        </p>
                        {urls.length > 0 && (
                          <p class="text-sm">
                            {urls.map((url, index) => (
                              <>
                                {index > 0 && t.listSeparator}
                                <a href={url} class={link}>
                                  {url}
                                </a>
                              </>
                            ))}
                          </p>
                        )}
                      </>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        ) : (
          // A list of credentials: the certifications, the course
          // completions, and on the resume whichever entries carry the
          // marker. One line each, which is what a reader scans and what a
          // parser reads.
          <section aria-labelledby={`cv-${section.id}`} data-cv-section={section.id}>
            <h2 id={`cv-${section.id}`} class={heading}>
              {section.heading}
            </h2>
            <ul class="mt-3 space-y-1 text-sm leading-6">
              {section.entries.map((entry) => {
                const { data } = entry;
                const text = localized(locale, 'certificates', entry.id);
                return (
                  <li class="cv-entry">
                    <span class="font-medium">{text('name', data.name)}</span>
                    {t.listSeparator}
                    <span class="text-muted-foreground">
                      {data.issuer}
                      {data.date && `${t.listSeparator}${formatDate(locale, data.date)}`}
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        )),
    )
  }
</article>
