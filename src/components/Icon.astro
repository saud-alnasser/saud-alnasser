---
import { icons, type IconName } from '../lib/icons';

// One inline SVG by name, drawn in the current text colour and sized by the
// class the caller passes (16 pixels when none is). The bodies themselves are
// in src/lib/icons.ts, because QrCode.astro draws the coded profile's mark
// from the same map and a mark typed out twice is a mark that can differ in
// two places.
//
// An icon is decoration unless it is given a label: alone it is hidden from
// assistive technology and the control it sits in names itself with text;
// with a label it is an image with that name.

interface Props {
  name: IconName;
  // The icon's accessible name, when it stands for something on its own.
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
const { kind, body } = icons[name];

// An icon that points along the reading direction mirrors in Arabic. The
// rest are symmetric or point up and down.
const directional: ReadonlyArray<IconName> = ['external-link'];

const escaped = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const markup = (label ? `<title>${escaped(label)}</title>` : '') + body;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="16"
  height="16"
  fill={kind === 'fill' ? 'currentColor' : 'none'}
  stroke={kind === 'stroke' ? 'currentColor' : undefined}
  stroke-width={kind === 'stroke' ? 2 : undefined}
  stroke-linecap={kind === 'stroke' ? 'round' : undefined}
  stroke-linejoin={kind === 'stroke' ? 'round' : undefined}
  role={label ? 'img' : undefined}
  aria-hidden={label ? undefined : 'true'}
  data-icon={name}
  class:list={['shrink-0', directional.includes(name) && 'rtl:-scale-x-100', className]}
  set:html={markup}
/>
