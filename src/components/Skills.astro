---
// The skill groups as cards in a grid: one column on a phone, two from the
// small breakpoint and three from the large one, so six groups are scanned
// rather than read down a column. A group shows its name, its level where
// the entry carries one, and its keywords as badges, each with its mark
// where src/lib/technologies.ts has one. The grid fills from the right in Arabic, because the
// document's direction is what orders a grid's columns.

import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import Card from './Card.astro';
import type { Locale } from '../lib/i18n';
import { localized } from '../lib/localized';

interface Props {
  locale: Locale;
  entries: CollectionEntry<'skills'>[];
}

const { locale, entries } = Astro.props;
---

<ul data-skill-grid class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    entries.map((entry) => {
      const text = localized(locale, 'skills', entry.id);
      return (
        <li data-reveal class="h-full">
          <Card as="article" data-skill-card class="h-full">
            <h3 class="font-semibold tracking-tight">{text('name', entry.data.name)}</h3>
            {entry.data.level && <p class="mt-1 text-sm text-muted-foreground">{text('level', entry.data.level)}</p>}
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {entry.data.keywords.map((keyword) => (
                <li>
                  <Badge name={keyword} />
                </li>
              ))}
            </ul>
          </Card>
        </li>
      );
    })
  }
</ul>
