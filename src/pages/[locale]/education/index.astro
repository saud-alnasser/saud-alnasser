---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Card from '../../../components/Card.astro';
import Certificate from '../../../components/Certificate.astro';
import CertificateDialog from '../../../components/CertificateDialog.astro';
import Education from '../../../components/Education.astro';
import Icon from '../../../components/Icon.astro';
import { fill, formatPeriod, locales, plural, strings, type Locale } from '../../../lib/i18n';
import { localized } from '../../../lib/localized';
import { byDateAscending, byStartAscending } from '../../../lib/order';
import { isCertification, isCourse } from '../../../lib/shown';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

const education = (await getCollection('education')).sort((a, b) => byStartAscending(a.data, b.data));

// The certificates collection is two sections of this page, told apart by the
// one field its entries carry (src/lib/shown.ts): a course completion and a
// credential that is not one. Both are sorted the same way, by date with the
// undated last, so reclassifying an entry moves its card between the grids
// and changes nothing else.
const certificates = (await getCollection('certificates')).sort((a, b) => byDateAscending(a.data, b.data));
const courses = certificates.filter(({ data }) => isCourse(data));
const certifications = certificates.filter(({ data }) => isCertification(data));

// The timeline is the institutions in order of time, by their start, with one
// node for the online-courses phase in the place the undated certificates used
// to take: immediately before the most recent institution. So the page reads
// high school, online courses, university, whatever dates the certificates
// carry, and a phase that spans years needs no date to sit where it belongs.
// src/content/README.md, "education/", says the same for whoever edits the content.
type Item = { kind: 'education'; entry: CollectionEntry<'education'> } | { kind: 'courses' };

const items: Item[] = education.map((entry): Item => ({ kind: 'education', entry }));
if (courses.length > 0) items.splice(Math.max(items.length - 1, 0), 0, { kind: 'courses' });

// The node stands for the courses section, dated entries and undated alike:
// it counts every course and runs from the earliest dated one to the latest.
// The courses themselves are below the timeline, under the heading it links
// to.
const dated = courses.filter((entry) => entry.data.date);
const period = dated.length > 0 ? { start: dated[0].data.date!, end: dated[dated.length - 1].data.date! } : undefined;
const count = fill(t.education.onlineCourses.count, {
  count: String(courses.length),
  noun: plural(locale, courses.length, t.education.onlineCourses.noun),
});
---

<Base
  locale={locale}
  title={`${t.pages.education.title}${t.titleSeparator}${name}`}
  description={fill(t.pages.education.description, { name })}
  path="/education/"
  column="grid"
>
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t.pages.education.title}</h1>

  <section aria-labelledby="studies" class="mt-12">
    <h2 id="studies" class="text-xl font-semibold tracking-tight">{t.sections.studies}</h2>
    <ol class="mt-8 border-s border-border">
      {
        items.map((item) => (
          <li class="relative ps-7 pb-6 last:pb-0">
            {/* The marker on the rail. The courses node takes the accent,
                because it is the one item on the timeline that leads
                somewhere else on the page. */}
            <span
              aria-hidden="true"
              class:list={[
                'absolute -start-[5px] top-6 size-2.5 rounded-full sm:top-7',
                item.kind === 'courses' ? 'bg-primary' : 'bg-border',
              ]}
            />
            {item.kind === 'education' ? (
              <Education locale={locale} entry={item.entry} />
            ) : (
              <Card href="#courses" data-courses-node>
                {period && (
                  <p class="text-sm text-muted-foreground tabular-nums" data-period>
                    {formatPeriod(locale, period)}
                  </p>
                )}
                <h3 class="mt-1 text-lg font-semibold tracking-tight">{t.education.onlineCourses.name}</h3>
                <p class="mt-1">{count}</p>
                <p class="mt-2 flex items-center gap-1.5 text-sm text-primary">
                  {t.education.onlineCourses.link}
                  <Icon name="chevron-down" class="size-4" />
                </p>
              </Card>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  {/*
    The courses as a grid of cards, in the same order the timeline node counts
    them: one column on a phone, two from 48rem up. The heading carries the
    anchor the node leads to.
  */}
  <section aria-labelledby="courses" class="mt-16">
    <h2 id="courses" class="text-xl font-semibold tracking-tight">{t.sections.courses}</h2>
    <ul data-grid="courses" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        courses.map((entry) => (
          <li>
            <Certificate locale={locale} entry={entry} />
          </li>
        ))
      }
    </ul>
  </section>

  {/*
    The certifications, the same grid of the same cards. Its heading keeps the
    id the certificates section had, so an inbound link to #certificates still
    lands on a credential rather than on nothing.
  */}
  <section aria-labelledby="certificates" class="mt-16">
    <h2 id="certificates" class="text-xl font-semibold tracking-tight">{t.sections.certifications}</h2>
    <ul data-grid="certifications" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        certifications.map((entry) => (
          <li>
            <Certificate locale={locale} entry={entry} />
          </li>
        ))
      }
    </ul>
  </section>

  {/* The one dialog every certificate card opens, outside main. */}
  <CertificateDialog locale={locale} slot="dialog" />
</Base>
