---
// The address the work page had, now forwarding to the experience section
// of the home page (src/lib/forwards.ts).
import Forward from '../../../components/Forward.astro';
import { locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}
---

<Forward locale={Astro.params.locale as Locale} section="experience" />
