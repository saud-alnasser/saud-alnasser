---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FeaturedProject from '../../../components/FeaturedProject.astro';
import Icon from '../../../components/Icon.astro';
import Project from '../../../components/Project.astro';
import Experience from '../../../components/Experience.astro';
import { fill, locales, plural, strings, type Locale } from '../../../lib/i18n';
import { localized } from '../../../lib/localized';
import { byOrderThenStartDescending, byStartDescending } from '../../../lib/order';
import { featuredProject, isShown } from '../../../lib/shown';
import { technologyMark } from '../../../lib/technologies';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const name = localized(locale, 'profile', profile.id)('name', profile.data.name);

// A hidden or unfinished project stays in the source and out of every output
// (src/lib/shown.ts).
const projects = (await getCollection('projects', ({ data }) => isShown(data))).sort((a, b) =>
  byOrderThenStartDescending(a.data, b.data),
);
// The one project the content marks featured leads the projects as a wider
// card, and leaves the grid, so it appears once. With none marked there is
// no featured card and the grid holds every project.
const featured = featuredProject(projects);
const grid = featured ? projects.filter((project) => project.id !== featured.id) : projects;

// The filter's chips: every technology two or more shown projects name,
// the featured one among them, most used first and then by name, so a chip
// never narrows the grid to the one card that named it. Each chip carries the
// line announced when it is pressed, counted and declined here, so the
// inline script that runs the filter needs no plural rules of its own.
const uses = new Map<string, number>();
for (const project of projects) {
  for (const technology of new Set(project.data.technologies)) uses.set(technology, (uses.get(technology) ?? 0) + 1);
}
const chips = [...uses]
  .filter(([, count]) => count >= 2)
  .sort(([a, x], [b, y]) => y - x || a.localeCompare(b, 'en'))
  .map(([technology, count]) => ({ technology, count, mark: technologyMark(technology) }));
const showing = (count: number) =>
  fill(t.filter.status, { count: String(count), noun: plural(locale, count, t.home.counts.nouns.projects) });
const chip =
  'inline-flex min-h-8 cursor-pointer items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-sm text-muted-foreground hover:border-primary hover:text-primary motion-safe:transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground';

const experience = (await getCollection('experience')).sort((a, b) => byStartDescending(a.data, b.data));
---

<Base
  locale={locale}
  title={`${t.pages.work.title}${t.titleSeparator}${name}`}
  description={fill(t.pages.work.description, { name })}
  path="/work/"
  column="grid"
>
  <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t.pages.work.title}</h1>

  {/*
    Experience comes first: a hiring reader looks for employment before
    anything else, and the two sections are what the home page's cards link
    to by these ids. Both are ordered lists laid out as a grid: one column on
    a phone, two from 48rem up, so the projects are scanned rather than
    scrolled. The grid is written on the list itself, so its items are its
    cards and the reading order is the order the collection was sorted into.
  */}
  <section aria-labelledby="experience" class="mt-12">
    <h2 id="experience" data-reveal class="flex items-center gap-2 text-xl font-semibold tracking-tight">
      <Icon name="briefcase" class="size-5 text-primary" />
      {t.sections.experience}
    </h2>
    <ol data-grid="experience" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        experience.map((entry) => (
          <li data-reveal>
            <Experience locale={locale} entry={entry} />
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="projects" class="mt-16">
    <h2 id="projects" data-reveal class="flex items-center gap-2 text-xl font-semibold tracking-tight">
      <Icon name="folder-code" class="size-5 text-primary" />
      {t.sections.projects}
    </h2>
    {
      featured && (
        <FeaturedProject
          locale={locale}
          entry={featured}
          class="mt-6"
          data-technologies={featured.data.technologies.join('|')}
        />
      )
    }
    {/*
      The filter ships hidden, and the inline script shows it and runs it; with
      no script there is no row and every project shows. It filters the
      featured card as it does the grid, in its own place above the grid, so
      what a chip leaves on screen is exactly the projects naming its
      technology and the number announced counts them. Which technology is
      chosen is a view of the page and is not written to the address, so a
      reload shows every project.
    */}
    {
      chips.length > 0 && (
        <div data-filter role="group" aria-label={t.filter.label} hidden class="mt-6 flex flex-wrap gap-2">
          <button type="button" data-filter-chip="" aria-pressed="true" data-status={showing(projects.length)} class={chip}>
            {t.filter.all}
          </button>
          {chips.map(({ technology, count, mark }) => (
            <button type="button" data-filter-chip={technology} aria-pressed="false" data-status={showing(count)} class={chip}>
              {mark && (
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor" class="size-3.5 shrink-0">
                  <path d={mark.path} />
                </svg>
              )}
              <bdi>{technology}</bdi>
            </button>
          ))}
        </div>
      )
    }
    <p data-filter-status role="status" class="mt-3 text-sm text-muted-foreground"></p>
    <ol data-grid="projects" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        grid.map((entry) => (
          <li data-reveal data-technologies={entry.data.technologies.join('|')}>
            <Project locale={locale} entry={entry} />
          </li>
        ))
      }
    </ol>
  </section>
</Base>
