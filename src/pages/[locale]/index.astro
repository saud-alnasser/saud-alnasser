---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Certificate from '../../components/Certificate.astro';
import CertificateDialog from '../../components/CertificateDialog.astro';
import Education from '../../components/Education.astro';
import Experience from '../../components/Experience.astro';
import FeaturedProject from '../../components/FeaturedProject.astro';
import Icon from '../../components/Icon.astro';
import Project from '../../components/Project.astro';
import Skills from '../../components/Skills.astro';
import StatTile from '../../components/StatTile.astro';
import { fill, formatPeriod, locales, plural, strings, type Locale } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { profileIcon, type ProfileIcon } from '../../lib/networks';
import {
  byDateDescending,
  byOrderThenName,
  byOrderThenStartDescending,
  byStartAscending,
  byStartDescending,
} from '../../lib/order';
import { withBase } from '../../lib/paths';
import { featuredProject, isCertification, isCourse, isShown } from '../../lib/shown';
import { technologyMark } from '../../lib/technologies';
import { educationTimeline } from '../../lib/timeline';
import type { IconName } from '../../lib/icons';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const text = localized(locale, 'profile', profile.id);
const name = text('name', profile.data.name);
const label = text('label', profile.data.label);
const summary = text('summary', profile.data.summary);
const location = text('location', profile.data.location);

const cv = withBase(`/${locale}/cv/`);
const resume = withBase(`/${locale}/resume/`);

// Where a visitor can go, as actions rather than a table. The CV first and
// filled in the accent, as the one thing a hiring reader most often came
// for; the resume beside it; then every profile. No email and no phone
// number: the site publishes neither, anywhere, and a document carrying them
// is made in a browser from a document page opened at the address that
// offers the form (docs/development.md).
// A profile takes its network's mark where the icon set has one and the
// external link icon where it does not (src/lib/networks.ts).
const actions: { key: string; href: string; icon: 'file-text' | ProfileIcon; label: string; primary?: boolean }[] = [
  { key: 'cv', href: cv, icon: 'file-text', label: t.nav.cv, primary: true },
  { key: 'resume', href: resume, icon: 'file-text', label: t.nav.resume },
  ...profile.data.profiles.map((p) => ({
    key: p.network.toLowerCase(),
    href: p.url,
    icon: profileIcon(p.network),
    label: p.network,
  })),
];

// The collections the sections below lay out, each in the order every output
// reads (src/lib/order.ts), through the filters every output reads
// (src/lib/shown.ts): a hidden or unfinished project stays in the source and
// out of every output, and a certificate belongs to the courses or to the
// certifications by its own field.
const experience = (await getCollection('experience')).sort((a, b) => byStartDescending(a.data, b.data));
const projects = (await getCollection('projects', ({ data }) => isShown(data))).sort((a, b) =>
  byOrderThenStartDescending(a.data, b.data),
);
const education = (await getCollection('education')).sort((a, b) => byStartAscending(a.data, b.data));
// Both certificate grids are sorted the same way, by date newest first with
// the undated last, so reclassifying an entry moves its card between the
// grids and changes nothing else.
const certificates = (await getCollection('certificates')).sort((a, b) => byDateDescending(a.data, b.data));
const courses = certificates.filter(({ data }) => isCourse(data));
const certifications = certificates.filter(({ data }) => isCertification(data));
const skills = (await getCollection('skills')).sort((a, b) => byOrderThenName(a.data, b.data));
const languages = await getCollection('languages');

// The four numbers the first screen leads with, each the length of what a
// section renders, read through the same filters, never written by hand. The
// technologies are the distinct names the shown projects list, not the skill
// keywords, some of which are practices rather than technologies.
const technologies = new Set(projects.flatMap((project) => project.data.technologies));
const tiles: { tile: string; icon: IconName; count: number; label: string }[] = [
  { tile: 'projects', icon: 'folder-code', count: projects.length, label: t.home.tiles.projects },
  { tile: 'certificates', icon: 'award', count: courses.length + certifications.length, label: t.home.tiles.certificates },
  { tile: 'technologies', icon: 'cpu', count: technologies.size, label: t.home.tiles.technologies },
  { tile: 'languages', icon: 'languages', count: languages.length, label: t.home.tiles.languages },
];

// The one project the content marks featured leads the projects as a wider
// card, and leaves the grid, so it appears once. With none marked there is
// no featured card and the grid holds every project.
const featured = featuredProject(projects);
const grid = featured ? projects.filter((project) => project.id !== featured.id) : projects;

// The filter's chips: every technology two or more shown projects name,
// the featured one among them, most used first and then by name, so a chip
// never narrows the grid to the one card that named it. Each chip carries the
// line announced when it is pressed, counted and declined here, so the
// inline script that runs the filter needs no plural rules of its own.
const uses = new Map<string, number>();
for (const project of projects) {
  for (const technology of new Set(project.data.technologies)) uses.set(technology, (uses.get(technology) ?? 0) + 1);
}
const chips = [...uses]
  .filter(([, count]) => count >= 2)
  .sort(([a, x], [b, y]) => y - x || a.localeCompare(b, 'en'))
  .map(([technology, count]) => ({ technology, count, mark: technologyMark(technology) }));
const showing = (count: number) =>
  fill(t.filter.status, { count: String(count), noun: plural(locale, count, t.home.counts.nouns.projects) });
const chip =
  'inline-flex min-h-8 cursor-pointer items-center gap-1.5 rounded-full border border-border bg-background px-3 py-1 text-sm text-muted-foreground hover:border-primary hover:text-primary motion-safe:transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground';

// The studies timeline is the institutions newest first, by their start,
// with one node for the online-courses phase immediately after the most
// recent institution, decided once in src/lib/timeline.ts for this page, the
// CV, and the checks: it reads university, online courses, high school,
// whatever dates the certificates carry. src/content/README.md,
// "education/", says the same for whoever edits the content.
//
// The node stands for the courses, dated entries and undated alike: it
// counts every course and runs from the earliest dated one to the latest.
// The courses themselves are below the timeline, under the heading it links
// to.
const items = educationTimeline(
  education,
  courses.map((entry) => entry.data),
);
const countOf = (count: number) =>
  fill(t.education.onlineCourses.count, { count: String(count), noun: plural(locale, count, t.education.onlineCourses.noun) });

const heading = 'flex items-center gap-2 text-xl font-semibold tracking-tight';
const subheading = 'flex items-center gap-2 text-lg font-semibold tracking-tight';
---

<Base locale={locale} title={name} description={summary} path="/" column="grid">
  {/*
    The whole portfolio on one page, in the order a hiring reader wants it:
    About, Experience, Projects, Education, and Skills. Each section is a
    landmark labelled by its heading, and the heading's id is the section's
    anchor, marked `data-section` for the header that links to it.

    About is the first screen: the name, what he does and where, the whole
    summary as the lead, the contact actions, and four numbers counted from
    the content, over a soft light in the accent. It is one block so its
    parts can enter one after another (src/styles/global.css), and so the
    light sits behind this block alone; the light is decoration and carries
    no text, and it comes last so the name is the block's first element. At
    1440 by 900 all of it is on the first screen, and on a phone everything
    down to the contact actions is.
  */}
  <section aria-labelledby="about" data-hero class="relative isolate">
    <h1 id="about" data-section class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{name}</h1>
    <p data-hero-label class="mt-2 text-lg text-muted-foreground sm:text-xl">{label}</p>
    <p data-hero-location class="mt-1 flex items-center gap-1.5 text-sm text-muted-foreground">
      <Icon name="map-pin" class="size-4" />
      <span class="sr-only">{t.home.location}: </span>{location}
    </p>
    <p data-hero-summary class="mt-5 max-w-prose leading-7 sm:mt-6 sm:text-lg sm:leading-8">{summary}</p>

    <section aria-labelledby="contact" class="mt-6">
      <h2 id="contact" class="sr-only">{t.home.contact}</h2>
      <ul data-contact-actions class="flex flex-wrap gap-2">
        {
          actions.map((action) => (
            <li>
              <a
                href={action.href}
                data-contact={action.key}
                class:list={[
                  'flex min-h-10 items-center gap-2 rounded-md border px-3 py-2 text-sm motion-safe:transition-colors',
                  action.primary
                    ? 'border-primary bg-primary font-medium text-primary-foreground hover:bg-primary/90'
                    : 'border-border bg-card hover:border-primary hover:text-primary',
                ]}
              >
                <Icon name={action.icon} class="size-4" />
                {action.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="glance" class="mt-8">
      <h2 id="glance" class="sr-only">{t.home.glance}</h2>
      <ul data-stat-tiles class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
        {
          tiles.map((tile) => (
            <li data-reveal>
              <StatTile
                tile={tile.tile}
                icon={tile.icon}
                count={tile.count}
                label={tile.label}
                spoken={fill(t.home.tiles.spoken, { count: String(tile.count), label: tile.label })}
              />
            </li>
          ))
        }
      </ul>
    </section>

    <div aria-hidden="true" data-glow class="pointer-events-none absolute inset-x-0 -top-24 -z-10 h-[32rem]"></div>
  </section>

  {/*
    Experience comes first: a hiring reader looks for employment before
    anything else. Experience and projects are ordered lists laid out as a
    grid: one column on a phone, two from 48rem up, so the projects are
    scanned rather than scrolled. The grid is written on the list itself, so
    its items are its cards and the reading order is the order the collection
    was sorted into.
  */}
  <section aria-labelledby="experience" class="mt-16">
    <h2 id="experience" data-section data-reveal class={heading}>
      <Icon name="briefcase" class="size-5 text-primary" />
      {t.sections.experience}
    </h2>
    <ol data-grid="experience" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        experience.map((entry) => (
          <li data-reveal>
            <Experience locale={locale} entry={entry} />
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="projects" class="mt-16">
    <h2 id="projects" data-section data-reveal class={heading}>
      <Icon name="folder-code" class="size-5 text-primary" />
      {t.sections.projects}
    </h2>
    {
      featured && (
        <FeaturedProject
          locale={locale}
          entry={featured}
          class="mt-6"
          data-technologies={featured.data.technologies.join('|')}
        />
      )
    }
    {/*
      The filter ships hidden, and the inline script shows it and runs it; with
      no script there is no row and every project shows. It filters the
      featured card as it does the grid, in its own place above the grid, so
      what a chip leaves on screen is exactly the projects naming its
      technology and the number announced counts them. Which technology is
      chosen is a view of the page and is not written to the address, so a
      reload shows every project.
    */}
    {
      chips.length > 0 && (
        <div data-filter role="group" aria-label={t.filter.label} hidden class="mt-6 flex flex-wrap gap-2">
          <button type="button" data-filter-chip="" aria-pressed="true" data-status={showing(projects.length)} class={chip}>
            {t.filter.all}
          </button>
          {chips.map(({ technology, count, mark }) => (
            <button type="button" data-filter-chip={technology} aria-pressed="false" data-status={showing(count)} class={chip}>
              {mark ? (
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor" class="size-3.5 shrink-0">
                  <path d={mark.path} />
                </svg>
              ) : (
                <Icon name="code" class="size-3.5" />
              )}
              <bdi>{technology}</bdi>
            </button>
          ))}
        </div>
      )
    }
    <p data-filter-status role="status" class="mt-3 text-sm text-muted-foreground"></p>
    <ol data-grid="projects" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
      {
        grid.map((entry) => (
          <li data-reveal data-technologies={entry.data.technologies.join('|')}>
            <Project locale={locale} entry={entry} />
          </li>
        ))
      }
    </ol>
  </section>

  {/*
    Education: the studies timeline, then the courses and the certifications
    as grids of cards under headings of their own, one column on a phone and
    two from 48rem up. The courses heading carries the anchor the timeline's
    node leads to.
  */}
  <section aria-labelledby="education" class="mt-16">
    <h2 id="education" data-section data-reveal class={heading}>
      <Icon name="graduation-cap" class="size-5 text-primary" />
      {t.nav.education}
    </h2>
    <ol class="mt-8 border-s border-border">
      {
        items.map((item) => (
          <li data-reveal class="relative ps-7 pb-6 last:pb-0">
            {/* The marker on the rail. The courses node takes the accent,
                because it is the one item on the timeline that leads
                somewhere else on the page. */}
            <span
              aria-hidden="true"
              class:list={[
                'absolute -start-[5px] top-6 size-2.5 rounded-full sm:top-7',
                item.kind === 'courses' ? 'bg-primary' : 'bg-border',
              ]}
            />
            {item.kind === 'education' ? (
              <Education locale={locale} entry={item.entry} />
            ) : (
              <Card href="#courses" data-courses-node>
                {item.period && (
                  <p class="text-sm text-muted-foreground tabular-nums" data-period>
                    {formatPeriod(locale, item.period)}
                  </p>
                )}
                <h3 class="mt-1 text-lg font-semibold tracking-tight">{t.education.onlineCourses.name}</h3>
                <p class="mt-1">{countOf(item.count)}</p>
                <p class="mt-2 flex items-center gap-1.5 text-sm text-primary">
                  {t.education.onlineCourses.link}
                  <Icon name="chevron-down" class="size-4" />
                </p>
              </Card>
            )}
          </li>
        ))
      }
    </ol>

    <section aria-labelledby="courses" class="mt-12">
      <h3 id="courses" data-reveal class={subheading}>
        <Icon name="book-open" class="size-5 text-primary" />
        {t.sections.courses}
      </h3>
      <ul data-grid="courses" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
        {
          courses.map((entry) => (
            <li data-reveal>
              <Certificate locale={locale} entry={entry} level={4} />
            </li>
          ))
        }
      </ul>
    </section>

    {/*
      The certifications, the same grid of the same cards, rendered only while
      an entry exists, the way the CV prints a section only where it holds
      something: a heading over an empty grid would say "no credential" in so
      many words. Its heading keeps the id the certificates section had, so an
      inbound link to #certificates still lands on a credential; with none, the
      anchor is absent rather than kept as an empty target.
    */}
    {
      certifications.length > 0 && (
        <section aria-labelledby="certificates" class="mt-12">
          <h3 id="certificates" data-reveal class={subheading}>
            <Icon name="award" class="size-5 text-primary" />
            {t.sections.certifications}
          </h3>
          <ul data-grid="certifications" class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-5">
            {certifications.map((entry) => (
              <li data-reveal>
                <Certificate locale={locale} entry={entry} level={4} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>

  {
    skills.length > 0 && (
      <section aria-labelledby="skills" class="mt-16">
        <h2 id="skills" data-section data-reveal class:list={[heading, 'mb-5']}>
          <Icon name="wrench" class="size-5 text-primary" />
          {t.sections.skills}
        </h2>
        <Skills locale={locale} entries={skills} />
      </section>
    )
  }

  {/* The one dialog every certificate card opens, outside main. */}
  <CertificateDialog locale={locale} slot="dialog" />
</Base>
