---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Journey from '../../components/Journey.astro';
import SectionCard from '../../components/SectionCard.astro';
import Skills from '../../components/Skills.astro';
import { fill, locales, plural, strings, type Locale, type Strings } from '../../lib/i18n';
import { localized } from '../../lib/localized';
import { profileIcon, type ProfileIcon } from '../../lib/networks';
import { byOrderThenName } from '../../lib/order';
import { withBase } from '../../lib/paths';
import { isCertification, isCourse, isShown } from '../../lib/shown';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const t = strings[locale];

const profile = (await getEntry('profile', 'profile'))!;
const text = localized(locale, 'profile', profile.id);
const name = text('name', profile.data.name);
const label = text('label', profile.data.label);
const summary = text('summary', profile.data.summary);
const location = text('location', profile.data.location);

const cv = withBase(`/${locale}/cv/`);
const resume = withBase(`/${locale}/resume/`);

// Where a visitor can go, as actions rather than a table. No email and no
// phone number: the site publishes neither, anywhere, and a document carrying
// them is made in a browser from a document page opened at the address that
// offers the form (docs/development.md).
// A profile takes its network's mark where the icon set has one and the
// external link icon where it does not (src/lib/networks.ts).
const actions: { key: string; href: string; icon: 'file' | ProfileIcon; label: string }[] = [
  ...profile.data.profiles.map((p) => ({
    key: p.network.toLowerCase(),
    href: p.url,
    icon: profileIcon(p.network),
    label: p.network,
  })),
  { key: 'cv', href: cv, icon: 'file', label: t.nav.cv },
  { key: 'resume', href: resume, icon: 'file', label: t.nav.resume },
];

// Skills sit on the home page, above the sections, because they are the
// fastest read for a visitor deciding whether to open the work page.
const skills = (await getCollection('skills')).sort((a, b) => byOrderThenName(a.data, b.data));

// Every count a section card shows is the length of the collection that
// section renders, read here and never written by hand, so a card cannot
// drift from the content source. The filters are the ones every output reads
// (src/lib/shown.ts): a hidden or unfinished project stays in the source and
// out of every output, this count included, and a certificate belongs to the
// courses section or to the certifications section by its own field.
const projects = await getCollection('projects', ({ data }) => isShown(data));
const experience = await getCollection('experience');
const education = await getCollection('education');
const courses = await getCollection('certificates', ({ data }) => isCourse(data));
const certifications = await getCollection('certificates', ({ data }) => isCertification(data));

const count = (n: number, noun: keyof Strings['home']['counts']['nouns']) =>
  fill(t.home.counts.line, { count: String(n), noun: plural(locale, n, t.home.counts.nouns[noun]) });

// One card per section of the site, in the order a hiring reader wants them,
// each leading to the heading of the section on the page that holds it: the
// work page carries experience and projects, the education page the studies
// timeline, the courses, and the certifications, and the skills are on this
// page already. The certifications heading keeps the `certificates` id it has
// always had. The CV is one document rather than a list, so it counts nothing.
const work = withBase(`/${locale}/work/`);
const educationPage = withBase(`/${locale}/education/`);

const sections = [
  {
    section: 'experience',
    href: `${work}#experience`,
    name: t.sections.experience,
    description: t.home.experience,
    counts: [count(experience.length, 'experience')],
  },
  {
    section: 'projects',
    href: `${work}#projects`,
    name: t.sections.projects,
    description: t.home.projects,
    counts: [count(projects.length, 'projects')],
  },
  {
    section: 'education',
    href: `${educationPage}#studies`,
    name: t.nav.education,
    description: t.home.education,
    counts: [count(education.length, 'education')],
  },
  {
    section: 'courses',
    href: `${educationPage}#courses`,
    name: t.sections.courses,
    description: t.home.courses,
    counts: [count(courses.length, 'courses')],
  },
  // Only while a certification exists, as the education page renders the
  // section only then: a card counting zero would say "no credential" in so
  // many words, and the heading it would lead to is not there.
  ...(certifications.length > 0
    ? [
        {
          section: 'certifications',
          href: `${educationPage}#certificates`,
          name: t.sections.certifications,
          description: t.home.certifications,
          counts: [count(certifications.length, 'certifications')],
        },
      ]
    : []),
  {
    section: 'skills',
    href: `${withBase(`/${locale}/`)}#skills`,
    name: t.sections.skills,
    description: t.home.skills,
    counts: [count(skills.length, 'skills')],
  },
  { section: 'cv', href: cv, name: t.nav.cv, description: t.home.cv },
  { section: 'resume', href: resume, name: t.nav.resume, description: t.home.resume },
];
---

<Base locale={locale} title={name} description={summary} path="/" column="grid">
  <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{name}</h1>
  <p data-hero-label class="mt-3 text-xl text-muted-foreground">{label}</p>
  <p class="mt-1 text-sm text-muted-foreground">
    <span class="sr-only">{t.home.location}: </span>{location}
  </p>
  <p data-hero-summary class="mt-8 max-w-prose text-lg leading-8">{summary}</p>

  <section aria-labelledby="contact" class="mt-8">
    <h2 id="contact" class="sr-only">{t.home.contact}</h2>
    <ul data-contact-actions class="flex flex-wrap gap-2">
      {
        actions.map((action) => (
          <li>
            <a
              href={action.href}
              data-contact={action.key}
              class="flex items-center gap-2 rounded-md border border-border bg-card px-3 py-2 text-sm hover:border-primary hover:text-primary motion-safe:transition-colors"
            >
              <Icon name={action.icon} class="size-4" />
              {action.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="journey" class="mt-16">
    <h2 id="journey" data-reveal class="mb-5 flex items-center gap-2 text-xl font-semibold tracking-tight">
      <Icon name="graduation-cap" class="size-5 text-primary" />
      {t.journey.heading}
    </h2>
    <Journey locale={locale} />
  </section>

  {
    skills.length > 0 && (
      <section aria-labelledby="skills" class="mt-16">
        <h2 id="skills" data-reveal class="mb-5 text-xl font-semibold tracking-tight">
          {t.sections.skills}
        </h2>
        <Skills locale={locale} entries={skills} />
      </section>
    )
  }

  <section aria-labelledby="sections" class="mt-16">
    <h2 id="sections" data-reveal class="mb-5 text-xl font-semibold tracking-tight">{t.home.sections}</h2>
    <ul data-section-grid class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        sections.map((section) => (
          <li data-reveal class="h-full">
            <SectionCard locale={locale} {...section} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
